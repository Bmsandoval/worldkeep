APP_NAME="WorldKeep"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Cognito Hosted UI (matches php-cognito-hosted-starter / go-cognito-hosted-starter)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=your-app-client-id
COGNITO_APP_CLIENT_SECRET=your-app-client-secret
# Hostname only, e.g. auth.example.com
COGNITO_DOMAIN=auth.example.com
# Must match Cognito app client callback URL
COGNITO_REDIRECT_URI=http://127.0.0.1:8000/app/auth/redirect
COGNITO_CLI_REDIRECT_URI=http://127.0.0.1:53682/callback
COGNITO_LOGOUT_URI=http://127.0.0.1:8000/app

# Go engine (MCP + REST) — server-side only from Laravel
WORLDKEEP_INTERNAL_URL=http://127.0.0.1:8788
WORLDKEEP_CAMPAIGN_ID=campaign_001
# WORLDKEEP_API_TOKEN=
