+<?php
+
+namespace Tests\Unit\Services\WorldKeep\Mcp;
+
+use App\Services\WorldKeep\Mcp\Instructions;
+use PHPUnit\Framework\TestCase;
+
+class InstructionsTest extends TestCase
+{
+    public function test_server_instructions_cover_campaign_bootstrap_and_resume(): void
+    {
+        $text = Instructions::SERVER;
+
+        $this->assertStringContainsString('CRITICAL — Starting a new campaign', $text);
+        $this->assertStringContainsString('do NOT stop after record_event', $text);
+        $this->assertStringContainsString('propose_world_update', $text);
+        $this->assertStringContainsString('commit_world_update', $text);
+        $this->assertStringContainsString('start_session', $text);
+        $this->assertStringContainsString('CRITICAL — Resuming a campaign', $text);
+        $this->assertStringContainsString('get_campaign_dashboard', $text);
+    }
+}
