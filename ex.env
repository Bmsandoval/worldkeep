# Worldkeep environment template — copy to local.env for secrets (gitignored).
# Application reads local.env in development when implemented.

# Directory for campaign SQLite files
WORLDKEEP_DATA_DIR=./data

# Unified Go HTTP listen address (MCP + REST in one process)
WORLDKEEP_HTTP_ADDR=:8788

# Legacy aliases — worldkeep-serve uses WORLDKEEP_HTTP_ADDR when set
WORLDKEEP_MCP_ADDR=:8788
WORLDKEEP_API_ADDR=:8788

# Laravel UI calls this server-side (same host in Docker: 127.0.0.1:8788)
# WORLDKEEP_INTERNAL_URL=http://127.0.0.1:8788

# Optional bearer token for REST API (v1.1+). When set, requires Authorization: Bearer <token>
# WORLDKEEP_API_TOKEN=dev-change-me

# Public URL when using a tunnel (v0.2+) — set after cloudflared prints URL
# WORLDKEEP_MCP_PUBLIC_URL=https://xxxx.trycloudflare.com

WORLDKEEP_LOG_LEVEL=info

# Permissions role for MCP writes/reads: owner | dm | player (default dm)
# WORLDKEEP_ROLE=dm
